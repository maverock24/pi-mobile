<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Talk playback keeps running with the screen off, so the player lives in a
         foreground service. This is the app's first foreground permission. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Web access keeps a listening socket open with the screen off. The
         connectedDevice type is the one that covers serving a connection, and
         its documented prerequisite is one of the network-state permissions;
         CHANGE_WIFI_STATE is the one declared here. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Web access keeps serving only if the app is exempt from Doze, which
         design section 9 item 7 chose. The permission backs the system dialog
         the app opens when the server starts; a refusal is handled by starting
         the server anyway, so the exemption is never a precondition. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Pairing only: ZXing decodes the QR /pair draws. Not required for chat or
         dictation, so the app still installs on a device without a camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- The app can open Tailscale so the human can connect the tunnel, and it
         says the app is missing rather than failing silently when it is not
         installed. Android 11 and later hide other packages from
         getPackageInfo and getLaunchIntentForPackage unless the app names the
         ones it talks to, so the package is declared here. This is visibility
         only: it grants no permission and lets the app start nothing. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:name=".PiRemoteApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiRemote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- QR pairing. The app has its own scanner (ZXing) and normally reads the
                 code there; this filter keeps a scanned deep link working too, since the
                 system camera resolves pi-remote:// on some devices. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pi-remote" android:host="pair" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The player behind the Talks screen. media3 starts it and promotes it to
             the foreground while audio plays, which is what keeps a talk going with
             the screen off and posts the media notification. Not exported: only this
             app binds it. -->
        <service
            android:name=".player.TalkPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The web server while the human has it on. The notification it posts
             is the only place a listener can be seen and stopped without opening
             the app. Not exported: only this app starts it. -->
        <service
            android:name=".web.WebAccessService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
