<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere. Cleartext is allowed only for the bridge: the tailnet
     MagicDNS name and its address, plus loopback.

     Android evaluates this policy per hostname, so prefer the MagicDNS name
     (the app's default) over a raw IP in the settings screen. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">your-laptop.your-tailnet.ts.net</domain>
        <domain includeSubdomains="true">xxxxxxxx.ts.net</domain>
        <domain includeSubdomains="false">192.0.2.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
