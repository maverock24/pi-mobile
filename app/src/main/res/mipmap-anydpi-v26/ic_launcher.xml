<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. minSdk is 26, so the v26 qualifier covers every
     supported device and no PNG fallback is needed. The monochrome layer is the
     same glyph, since a themed icon discards colour and tints the coverage. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
