        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2a10,10 0 1,0 0,20a10,10 0 1,0 0,-20zM12,7a5,5 0 1,1 0,10a5,5 0 1,1 0,-10z" />
</vector>
